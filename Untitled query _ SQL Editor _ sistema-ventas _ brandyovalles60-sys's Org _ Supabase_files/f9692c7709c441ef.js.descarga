.i(311827),i=e.i(497761);async function n({projectRef:e,connectionString:t,schemas:i=["public"],search:n,limit:o=100,page:s=0,sort:l="alphabetical",filterTypes:c=Object.values(a.ENTITY_TYPE)},d){let u=`
    with records as (
      select
        c.oid::int8 as "id",
        nc.nspname as "schema",
        c.relname as "name",
        c.relkind as "type",
        case c.relkind
          when 'r' then 1
          when 'v' then 2
          when 'm' then 3
          when 'f' then 4
          when 'p' then 5
        end as "type_sort",
        obj_description(c.oid) as "comment",
        count(*) over() as "count",
        c.relrowsecurity as "rls_enabled"
      from
        pg_namespace nc
        join pg_class c on nc.oid = c.relnamespace
      where
        c.relkind in (${c.map(e=>`'${e}'`).join(", ")})
        and not pg_is_other_temp_schema(nc.oid)
        and (
          pg_has_role(c.relowner, 'USAGE')
          or has_table_privilege(
            c.oid,
            'SELECT, INSERT, UPDATE, DELETE, TRUNCATE, REFERENCES, TRIGGER'
          )
          or has_any_column_privilege(c.oid, 'SELECT, INSERT, UPDATE, REFERENCES')
        )
        and nc.nspname in (${i.map(e=>`'${e}'`)})
        ${n?`and c.relname ilike '%${n}%'`:""}
      order by ${"alphabetical"===l?"c.relname asc":'"type_sort" asc, c.relname asc'}
      limit ${o}
      offset ${s*o}
    )
    select
      jsonb_build_object(
        'entities', coalesce(jsonb_agg(
          jsonb_build_object(
            'id', r.id,
            'schema', r.schema,
            'name', r.name,
            'type', r.type,
            'comment', r.comment,
            'rls_enabled', r.rls_enabled
          )
          order by ${"alphabetical"===l?"r.name asc":"r.type_sort asc, r.name asc"}
        ), '[]'::jsonb),
        'count', coalesce(min(r.count), 0)
